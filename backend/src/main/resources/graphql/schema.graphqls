# --- TYPES ---

type User {
    id: ID!
    email: String!
    username: String
    avatar: String
    subscription: String
}

type AuthPayload {
    token: String!
    user: User!
}

type ListParticipant {
    username: String
    avatar: String
    lastSeen: String
}

type ShoppingItem {
    id          : ID!
    name        : String!
    quantity    : Float
    unit        : String
    category    : String
    dueDate     : String
    comment     : String
    priceStore1 : Float
    priceStore2 : Float
    userPrice   : Float
    completed   : Boolean!
    imageUrl    : String
    createdAt   : String
    addedBy     : String
    addedByAvatar: String
    completedBy : String
    completedByAvatar: String
}

type ShoppingList {
    id    : ID!
    name  : String!
    owner : String
    items : [ShoppingItem]!
    participants: [ListParticipant]
    messages: [ChatMessage]
}

type ChatMessage {
    id: ID
    sender: String
    avatar: String
    text: String
    timestamp: String
}

# Новый тип для активности
type ActivityLog {
    id: ID!
    user: String!      # Имя пользователя
    action: String!    # Текст действия (added, completed...)
    target: String!    # Объект (Milk, Family List...)
    type: String!      # Тип иконки (add, complete, join, delete)
    timestamp: String! # Время события
}

# --- INPUTS ---

input UserInput {
    username: String!
    avatar: String
}

input AddItemInput {
    name: String!
    quantity: Float
    unit: String
    category: String
    dueDate: String
    comment: String
    priceStore1: Float
    priceStore2: Float
    userPrice: Float
}

input UpdateItemInput {
    name: String
    quantity: Float
    unit: String
    category: String
    dueDate: String
    comment: String
    priceStore1: Float
    priceStore2: Float
    userPrice: Float
    imageUrl: String
}

# --- QUERY ---

type Query {
    allLists: [ShoppingList]!
    listById(id: ID!, user: UserInput): ShoppingList
    searchImages(query: String!): [String]!

    # Новый запрос
    recentActivity: [ActivityLog]!
}

# --- MUTATION ---

type Mutation {
    requestLoginCode(email: String!): Boolean!
    loginWithCode(email: String!, code: String!): AuthPayload!
    updateUserProfile(username: String!, avatar: String!): User!
    updateUserSubscription(plan: String!): User!

    createList(name: String!): ShoppingList!
    deleteList(id: ID!): Boolean!
    addItem(listId: ID!, itemInput: AddItemInput!, user: UserInput!): ShoppingItem!
    updateItem(listId: ID!, itemId: ID!, itemInput: UpdateItemInput!): ShoppingItem!
    removeItem(listId: ID!, itemId: ID!): Boolean!
    toggleItem(listId: ID!, itemId: ID!, completed: Boolean!, user: UserInput!): ShoppingItem!
    sendMessage(listId: ID!, text: String!, user: UserInput!): ChatMessage!
}

# --- SUBSCRIPTION ---

type Subscription {
    listUpdated(listId: ID!): ShoppingList
}